<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SessionSearch.Core\SessionSearch.Core.csproj" />
    <ProjectReference Include="..\SessionSearch.Infrastructure\SessionSearch.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SessionSearch</AssemblyName>
    <Product>Session Search</Product>
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <ApplicationIcon>Assets\SessionSearch.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\SessionSearch.ico"
                      LogicalName="SessionSearch.App.Assets.SessionSearch.ico" />
  </ItemGroup>

</Project>
